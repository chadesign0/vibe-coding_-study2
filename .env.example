# 네이버 개발자센터 애플리케이션에서 발급 (검색 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고 API (월간조회수 자동 수집)
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# ── 서버(server.py, Render 환경변수) ──
# 채점 워크플로 실행·데이터 push 용 GitHub 토큰 (repo, workflow 권한)
GITHUB_TOKEN=
# GitHub Actions → 서버 webhook 인증값. 저장소 Secrets 의 WEBHOOK_SECRET 과 같은 값
WEBHOOK_SECRET=
# 선택: 채점 근거 파일을 저장하는 브랜치 (기본값 scoring-evidence)
# GITHUB_EVIDENCE_BRANCH=scoring-evidence

# ── 채점 품질 검사(build_month.py, 선택) ──
# 측정 실패 칸 비율이 이 값을 넘으면 LOW 처리 (기본 0.20)
# SCORING_MAX_FAIL_RATIO=0.20
# LOW 일 때 결과 저장을 막을지 (기본 1, 끄려면 0)
# SCORING_BLOCK_ON_LOW_QUALITY=1
# 양수 점수 중 브라우저로 자동 교차검증할 키워드 수 (PC/MOB 각각, 기본 12)
# PLAYWRIGHT_AUDIT_SIZE=12
